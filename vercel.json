{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "wsw.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "wsw.py"
    },
    {
      "source": "/(.*)",
      "destination": "$1"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "env": {
    "PYTHON_VERSION": "3.9"
  }
}